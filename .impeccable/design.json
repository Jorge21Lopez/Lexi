  "components": [
    {
      "name": "Primary Button (GO)",
      "kind": "button",
      "refersTo": "button-primary-big",
      "description": "The course action: GO on Home, Next in sessions. Full width, purple.",
      "html": "<button class=\"ds-btn-primary\">GO <svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h13M13 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:60px;padding:0 18px;border-radius:5px;border:1px solid var(--course,#7B2CBF);background:var(--course,#7B2CBF);color:var(--course-ink,#fff);font-family:\"Barlow Condensed\",\"Barlow\",sans-serif;font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:22px;box-shadow:0 6px 18px rgba(123,44,191,.32);cursor:pointer;transition:transform .12s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:2px solid var(--course,#7B2CBF);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every non-course action.",
      "html": "<button class=\"ds-btn\">Quick session (5)</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;width:100%;padding:0 18px;border-radius:5px;border:1px solid var(--rule,#CDBFA9);background:var(--surface,#fff);color:var(--ink,#1E2118);font-family:\"Barlow\",sans-serif;font-weight:600;font-size:16px;cursor:pointer;transition:transform .12s cubic-bezier(.16,1,.3,1),background-color .15s}.ds-btn:active{transform:scale(.98)}.ds-btn:hover{background:var(--surface-2,#ECEFE6)}.ds-btn:focus-visible{outline:2px solid var(--course,#7B2CBF);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Typed answers and imports; purple caret and focus halo.",
      "html": "<input class=\"ds-field\" placeholder=\"Type the word\">",
      "css": ".ds-field{width:100%;min-height:56px;padding:12px 14px;border-radius:5px;border:1px solid var(--rule,#CDBFA9);background:var(--surface,#fff);color:var(--ink,#1E2118);font-family:\"Barlow\",sans-serif;font-size:19px;caret-color:var(--course,#7B2CBF)}.ds-field::placeholder{color:var(--muted,#665A48);opacity:.8}.ds-field:focus{outline:none;border-color:var(--course,#7B2CBF);box-shadow:0 0 0 3px var(--course-soft,#F2E9FB)}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Five fixed tabs (three shown); active tab purple with a 3px top bar.",
      "html": "<nav class=\"ds-tabs\"><button aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 4 3 6v14l6-2 6 2 6-2V4l-6 2z\"/><path d=\"M9 4v14M15 6v14\"/></svg><span>Home</span></button><button><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19V5a2 2 0 0 1 2-2h14v14H6a2 2 0 0 0-2 2 2 2 0 0 0 2 2h14\"/><path d=\"M8 7h8\"/></svg><span>Study</span></button><button><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 21V3\"/><path d=\"M5 4h14v10H5z\"/><path d=\"M5 4l14 10\"/></svg><span>Tests</span></button></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(3,1fr);background:var(--surface,#fff);border-top:1px solid var(--rule,#CDBFA9)}.ds-tabs button{position:relative;height:64px;background:none;border:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--muted,#665A48);font-family:\"Barlow Condensed\",\"Barlow\",sans-serif;font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:14px;cursor:pointer}.ds-tabs button::before{content:\"\";position:absolute;top:-1px;left:22%;right:22%;height:3px;background:var(--course,#7B2CBF);transform:scaleX(0);transition:transform .35s cubic-bezier(.16,1,.3,1)}.ds-tabs button[aria-current=\"page\"]{color:var(--course,#7B2CBF)}.ds-tabs button[aria-current=\"page\"]::before{transform:scaleX(1)}.ds-tabs button:hover{color:var(--ink,#1E2118)}.ds-tabs button:focus-visible{outline:2px solid var(--course,#7B2CBF);outline-offset:-2px}"
    },
    {
      "name": "Level Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Level and count tags in contour caps; open-land variant.",
      "html": "<span class=\"ds-chip\">B2</span> <span class=\"ds-chip ds-chip-alt\">NEW</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;padding:1px 7px;border-radius:4px;border:1px solid var(--rule,#CDBFA9);background:var(--surface,#fff);color:var(--contour,#8C5A2B);font-family:\"Barlow Condensed\",sans-serif;font-weight:700;font-size:14px;letter-spacing:.05em}.ds-chip-alt{border-color:transparent;background:var(--open-bg,#FFF4CC);color:var(--open-ink,#6E5200)}"
    },
    {
      "name": "Note Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Container without shadow; marsh-blue note variant for the Claude loop.",
      "html": "<div class=\"ds-panel\"><h3>Time for a review with Claude</h3><p>Copy your updates and paste them in the chat.</p></div>",
      "css": ".ds-panel{background:var(--water-bg,#E3F0F8);border-radius:6px;padding:16px;font-family:\"Barlow\",sans-serif;font-size:15px;color:var(--ink,#1E2118)}.ds-panel h3{margin:0 0 6px;font-size:18px;font-weight:700;color:var(--water-ink,#1D628F)}.ds-panel p{margin:0}"
    },
    {
      "name": "Course Strip",
      "kind": "custom",
      "refersTo": "control-done",
      "description": "Signature: controls joined by the purple line; start, done, none, open and finish.",
      "html": "<div class=\"ds-course\"><div class=\"ds-leg\"></div><div class=\"ds-ctrl ds-start\"><span class=\"ds-mk\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\"><path d=\"M12 4 21 19.5H3z\" fill=\"none\" stroke=\"#7B2CBF\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg></span><span class=\"ds-lb\">Start</span></div><div class=\"ds-ctrl ds-done\"><span class=\"ds-mk\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7\"/></svg><b class=\"ds-num\">1</b></span><span class=\"ds-lb\">Review</span></div><div class=\"ds-ctrl ds-none\"><span class=\"ds-mk\"><b class=\"ds-num\">2</b></span><span class=\"ds-lb\">None left</span></div><button class=\"ds-ctrl\"><span class=\"ds-mk\"><b class=\"ds-num\">3</b></span><span class=\"ds-lb\">Test</span></button><div class=\"ds-ctrl ds-finish\"><span class=\"ds-mk\"></span><span class=\"ds-lb\">Finish</span></div></div>",
      "css": ".ds-course{position:relative;display:flex;justify-content:space-between;align-items:flex-start;padding:10px 16px 0 2px}.ds-course::before{content:\"\";position:absolute;left:24px;right:38px;top:31px;height:3px;background:#7B2CBF;opacity:.25}.ds-leg{position:absolute;left:24px;top:31px;height:3px;width:24%;background:#7B2CBF}.ds-ctrl{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:6px;background:none;border:none;padding:0;min-width:44px;cursor:pointer}.ds-mk{position:relative;width:44px;height:44px;box-sizing:border-box;border-radius:50%;border:3px solid #7B2CBF;background:#F3F5EF;display:flex;align-items:center;justify-content:center;color:#fff}.ds-num{position:absolute;top:-8px;right:-14px;font:700 20px/1 \"Barlow Condensed\",sans-serif;color:#7B2CBF;background:#F3F5EF;padding:0 1px}.ds-done .ds-mk{background:#7B2CBF}.ds-none .ds-mk{border-style:dashed;opacity:.5}.ds-start .ds-mk{border:none}.ds-finish .ds-mk{border:none;box-shadow:inset 0 0 0 3px #7B2CBF,inset 0 0 0 7px #F3F5EF,inset 0 0 0 10px #7B2CBF}.ds-lb{font-family:\"Barlow Condensed\",\"Barlow\",sans-serif;font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:14px;letter-spacing:.05em;color:#1E2118}.ds-none .ds-lb{opacity:.6}button.ds-ctrl:hover .ds-mk{background:#F2E9FB}button.ds-ctrl:focus-visible{outline:2px solid var(--course,#7B2CBF);outline-offset:2px}"
    },
    {
      "name": "Control-description Table",
      "kind": "custom",
      "refersTo": "control-description-table",
      "description": "Signature IOF sheet: number | terrain symbol | description | value.",
      "html": "<table class=\"ds-cd\"><tr><th>1</th><td class=\"ds-sym\"><i class=\"ds-sw\"></i></td><td>Reviews due</td><td class=\"ds-v\">8</td></tr><tr><th>2</th><td class=\"ds-sym\"><i class=\"ds-sw\"></i></td><td>New words</td><td class=\"ds-v\">12</td></tr></table>",
      "css": ".ds-cd{width:100%;border-collapse:collapse;background:var(--surface,#fff);border:1.5px solid var(--ink,#1E2118);font-family:\"Barlow\",sans-serif;font-size:16px;color:var(--ink,#1E2118)}.ds-cd th,.ds-cd td{border:1px solid var(--rule,#CDBFA9);padding:9px 10px;text-align:left}.ds-cd th{width:44px;text-align:center;font:700 18px \"Barlow Condensed\",sans-serif}.ds-cd .ds-sym{width:48px;padding:6px}.ds-sw{display:block;width:34px;height:24px;background:var(--open,#FFD24D);border:1px solid rgba(30,33,24,.25)}.ds-cd .ds-v{width:1%;text-align:right;font:700 20px \"Barlow Condensed\",sans-serif;font-variant-numeric:tabular-nums}.ds-cd tr:hover td{background:var(--surface-2,#ECEFE6)}"
    },
    {
      "name": "Question Sheet",
      "kind": "custom",
      "refersTo": "question-sheet",
      "description": "Signature exercise card: ruled header row, prompt with the purple gap underline.",
      "html": "<div class=\"ds-sheet\"><div class=\"ds-ch\"><span class=\"ds-n\">1</span><span class=\"ds-t\">Choose the word</span><span class=\"ds-lv\">B2</span></div><p class=\"ds-sentence\">I&#39;m <span class=\"ds-slot\">&nbsp;</span> to hear that you&#39;ve got the job!</p></div>",
      "css": ".ds-sheet{background:var(--surface,#fff);border:1.5px solid var(--ink,#1E2118)}.ds-ch{display:flex;border-bottom:1px solid var(--rule,#CDBFA9);font-family:\"Barlow Condensed\",\"Barlow\",sans-serif;font-weight:700;letter-spacing:.06em;text-transform:uppercase;}.ds-ch>*{display:flex;align-items:center;padding:7px 10px}.ds-n{width:44px;justify-content:center;border-right:1px solid var(--rule,#CDBFA9);color:var(--course,#7B2CBF);font-size:19px;letter-spacing:0}.ds-t{flex:1;font-size:15px;color:var(--contour,#8C5A2B)}.ds-lv{border-left:1px solid var(--rule,#CDBFA9);font-size:16px}.ds-sentence{margin:0;padding:22px 18px 24px;font:500 26px/1.45 \"Barlow\",sans-serif;color:var(--ink,#1E2118)}.ds-slot{display:inline-block;min-width:88px;border-bottom:3px solid var(--course,#7B2CBF);line-height:1.1}"
    },
    {
      "name": "Answer Option",
      "kind": "button",
      "refersTo": "option",
      "description": "Lettered option rows; correct = ok wash, wrong = bad wash and struck.",
      "html": "<div class=\"ds-opts\"><button class=\"ds-opt ds-ok\"><span class=\"ds-ol\">A</span>delighted</button><button class=\"ds-opt\"><span class=\"ds-ol\">B</span>delicious</button><button class=\"ds-opt ds-bad\"><span class=\"ds-ol\">C</span><s>delightful</s></button></div>",
      "css": ".ds-opts{display:grid;gap:10px}.ds-opt{display:flex;align-items:center;gap:12px;min-height:58px;padding:10px 14px;border-radius:5px;border:1px solid var(--rule,#CDBFA9);background:var(--surface,#fff);color:var(--ink,#1E2118);font:500 18px \"Barlow\",sans-serif;text-align:left;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-ol{flex:none;width:30px;height:30px;box-sizing:border-box;border-radius:50%;border:2px solid var(--rule,#CDBFA9);display:inline-flex;align-items:center;justify-content:center;font:700 16px \"Barlow Condensed\",sans-serif;color:var(--muted,#665A48)}.ds-opt:hover{border-color:var(--course,#7B2CBF);background:var(--course-soft,#F2E9FB)}.ds-opt:focus-visible{outline:2px solid var(--course,#7B2CBF);outline-offset:2px}.ds-ok{background:var(--ok-bg,#EDF1DD);border-color:var(--ok,#47601A);color:var(--ok,#47601A);font-weight:700}.ds-ok .ds-ol{background:var(--ok,#47601A);border-color:var(--ok,#47601A);color:#fff}.ds-bad{background:var(--bad-bg,#FBE6E1);border-color:var(--bad,#B5341F);color:var(--bad,#B5341F)}.ds-bad .ds-ol{background:var(--bad,#B5341F);border-color:var(--bad,#B5341F);color:#fff}"
    }
  ],
  "narrative": {
    "northStar": "The Day's Course",
    "overview": "Lexi is drawn as an ISOM orienteering map and its IOF control-description sheet. Studying is running a course: today's work is laid out as numbered controls joined by a purple line, and each exercise answered punches a control. The map supplies everything else. Surfaces are runnable-forest white, sections carry terrain inks (open-land yellow, thicket green, rough, marsh blue, contour brown, rock grey), and data is set in ruled sheets with condensed caps headers, the way a control-description card is printed.\n\nThe system is dense, ruled and flat. Depth comes from rules and ink weight (a 1.5px ink border marks a sheet, a 1px rule marks a row), not from soft shadows or rounded white cards. Type is one family in two widths: Barlow Condensed caps for display, numerals and labels; Barlow for reading, with tabular figures everywhere. The world ships in a light map (paper) and a dark map (night run) with the same roles in both.\n\nIt refuses the category default of study apps: rounded white cards, mascots, confetti and a daily-goal ring. Purple is never decoration; it is the course.",
    "keyCharacteristics": [
      "Course purple marks the route and your next move, nothing else.",
      "One skill, one terrain symbol, on every screen.",
      "Ruled sheets (1.5px ink frame, 1px rule cells) in place of cards for data and exercises.",
      "Condensed caps for labels and numerals, Barlow for prose, tabular figures throughout.",
      "Square-ish corners (5–6px), sheets fully square; no ambient card shadows.",
      "Motion is the line drawing to the next control; all of it is off under reduced motion."
    ],
    "rules": [
      {
        "name": "The Overprint Rule",
        "body": "Course purple marks the course and the user's own move on it: the line, controls, control numbers, primary action, active tab, selection, focus and the gap to fill. It never marks a section, a category, a chart series or decoration. Toggles that are not \"the course\" use ink (segmented, chips) or thicket-ink (switches).",
        "section": "colors"
      },
      {
        "name": "The One Key Rule",
        "body": "Each skill has exactly one terrain symbol across the app: vocabulary = open land, grammar and Use of English = thicket, reading = rough, listening = marsh/water, writing = contour, speaking = rock. A section spanning several skills (Study, Tests, Write, Progress on Home's map legend) uses its tab icon, never a swatch.",
        "section": "colors"
      },
      {
        "name": "The Verdict Inks Rule",
        "body": "Green, amber and red mean correct, near and wrong, and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Two Widths Rule",
        "body": "Condensed caps label and count; normal width explains. Never set a paragraph in Condensed, never set a number in a proportional figure.",
        "section": "typography"
      },
      {
        "name": "The Ruled Not Raised Rule",
        "body": "If a container needs separation, give it a rule or an ink frame, not a shadow. The three shadows above are the whole vocabulary.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep course purple to the course and the user's move: line, controls, numbers, primary button, active tab, gap underline, selection, focus.",
      "**Do** tag every single-skill surface with its terrain symbol from the one key, and use tab icons for multi-skill sections.",
      "**Do** set data and exercises as ruled sheets: 1.5px ink frame, 1px rule cells, square corners, Condensed caps header cells in contour brown.",
      "**Do** use Condensed caps for labels and every number, with tabular figures.",
      "**Do** render a leg with nothing to do as a dashed `none` control, never as punched.",
      "**Do** define every new colour as a light/dark token pair and check it under both `prefers-color-scheme` and the `data-theme` override.",
      "**Do** gate every new animation behind `prefers-reduced-motion`."
    ],
    "donts": [
      "**Don't** use purple for sections, categories, chart series, badges or decoration.",
      "**Don't** give two skills the same swatch or one skill two swatches.",
      "**Don't** put soft shadows on panels or cards; separation is a rule or an ink frame. GO, the pinned footer and toasts are the only shadows.",
      "**Don't** round past 6px or build rounded white cards, mascots, confetti or a daily-goal ring.",
      "**Don't** add texture outside the header band and the terrain swatches.",
      "**Don't** set prose in Barlow Condensed."
    ]
  }
}